# ==============================================================
# AI Support & Operations Assistant — Environment Configuration
# ==============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# --------------------------------------------------------------
# OpenRouter API
# Get your key at: https://openrouter.ai/keys
# --------------------------------------------------------------
OPENROUTER_API_KEY=test-key

# Model to use for ticket processing
# Options: openai/gpt-4o-mini, openai/gpt-4o, anthropic/claude-3-haiku, mistralai/mistral-7b-instruct
OPENROUTER_MODEL=openai/gpt-4o-mini

# Your app URL (used as HTTP-Referer header for OpenRouter)
APP_URL=http://localhost:8000

# --------------------------------------------------------------
# Application Settings
# --------------------------------------------------------------
APP_NAME=AI Support & Operations Assistant
APP_VERSION=0.1.0
DEBUG=true

# --------------------------------------------------------------
# Database
# SQLite for development, PostgreSQL for production
# --------------------------------------------------------------
# SQLite (default for development):
DATABASE_URL=sqlite:///./app/data/tickets.db

# PostgreSQL (uncomment for production):
# DATABASE_URL=postgresql://user:password@localhost:5432/support_db

# --------------------------------------------------------------
# API Settings
# --------------------------------------------------------------
# API host and port (used when running directly, not via uvicorn args)
API_HOST=0.0.0.0
API_PORT=8000

# Request timeout for OpenRouter API calls (seconds)
AI_REQUEST_TIMEOUT=30
APP_ENV=local
DATABASE_URL=sqlite:///./app.db
